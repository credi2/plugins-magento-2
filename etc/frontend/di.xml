<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Checkout\Model\CompositeConfigProvider">
        <arguments>
            <argument name="configProviders" xsi:type="array">
                <item name="cashpresso_bnpl_invoice_config_provider" xsi:type="object">Credi2\CashpressoPayments\Model\Ui\BnplInvoiceConfigProvider</item>
                <item name="cashpresso_bnpl_installment_config_provider" xsi:type="object">Credi2\CashpressoPayments\Model\Ui\BnplInstallmentConfigProvider</item>
                <item name="cashpresso_config_provider" xsi:type="object">Credi2\CashpressoPayments\Model\Ui\CashpressoConfigProvider</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Framework\Pricing\Render\PriceBox">
        <plugin name="credi2_cashpresso_after_price"
                type="Credi2\CashpressoPayments\Plugin\Pricing\AfterPriceBoxHtml"/>
    </type>
</config>