<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Cashpresso Classic Payment Method -->
    <virtualType name="CashpressoFacade" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="string">cashpresso</argument>
            <argument name="formBlockType" xsi:type="string">Credi2\CashpressoPayments\Block\Payment\Form</argument>
            <argument name="infoBlockType" xsi:type="string">Credi2\CashpressoPayments\Block\Info</argument>
            <argument name="valueHandlerPool" xsi:type="object">CashpressoValueHandlerPool</argument>
            <argument name="commandPool" xsi:type="object">CashpressoCommandPool</argument>
        </arguments>
    </virtualType>

    <!-- BNPL Installment Payment Method -->
    <virtualType name="CashpressoBnplInstallmentFacade" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="string">cashpresso_bnpl_installment</argument>
            <argument name="formBlockType" xsi:type="string">Credi2\CashpressoPayments\Block\Payment\Form</argument>
            <argument name="infoBlockType" xsi:type="string">Credi2\CashpressoPayments\Block\Info</argument>
            <argument name="valueHandlerPool" xsi:type="object">CashpressoBnplInstallmentValueHandlerPool</argument>
            <argument name="commandPool" xsi:type="object">CashpressoBnplInstallmentCommandPool</argument>
        </arguments>
    </virtualType>

    <!-- BNPL Invoice Payment Method -->
    <virtualType name="CashpressoBnplInvoiceFacade" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="string">cashpresso_bnpl_invoice</argument>
            <argument name="formBlockType" xsi:type="string">Credi2\CashpressoPayments\Block\Payment\Form</argument>
            <argument name="infoBlockType" xsi:type="string">Credi2\CashpressoPayments\Block\BnplInvoiceInfo</argument>
            <argument name="valueHandlerPool" xsi:type="object">CashpressoBnplInvoiceValueHandlerPool</argument>
            <argument name="commandPool" xsi:type="object">CashpressoBnplInvoiceCommandPool</argument>
        </arguments>
    </virtualType>

    <!-- Value Handler Pools -->
    <virtualType name="CashpressoValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">CashpressoConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="CashpressoBnplInstallmentValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">CashpressoBnplInstallmentConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="CashpressoBnplInvoiceValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">CashpressoBnplInvoiceConfigValueHandler</item>
                <item name="order_place_redirect_url" xsi:type="string">Credi2\CashpressoPayments\Gateway\Config\RedirectUrlValueHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Config Value Handlers -->
    <virtualType name="CashpressoConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">CashpressoConfig</argument>
        </arguments>
    </virtualType>

    <virtualType name="CashpressoBnplInstallmentConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">CashpressoBnplInstallmentConfig</argument>
        </arguments>
    </virtualType>

    <virtualType name="CashpressoBnplInvoiceConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">CashpressoBnplInvoiceConfig</argument>
        </arguments>
    </virtualType>

    <!-- Configuration Objects -->
    <virtualType name="CashpressoConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="string">cashpresso</argument>
        </arguments>
    </virtualType>

    <virtualType name="CashpressoBnplInstallmentConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="string">cashpresso_bnpl_installment</argument>
        </arguments>
    </virtualType>

    <virtualType name="CashpressoBnplInvoiceConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="string">cashpresso_bnpl_invoice</argument>
        </arguments>
    </virtualType>

    <!-- Command Pools -->
    <virtualType name="CashpressoCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="authorize" xsi:type="string">Credi2\CashpressoPayments\Gateway\Command\AuthorizeCommand</item>
                <item name="capture" xsi:type="string">Credi2\CashpressoPayments\Gateway\Command\CaptureCommand</item>
                <item name="refund" xsi:type="string">Credi2\CashpressoPayments\Gateway\Command\RefundCommand</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="CashpressoBnplInstallmentCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="authorize" xsi:type="string">Credi2\CashpressoPayments\Gateway\Command\BnplAuthorizeCommand</item>
                <item name="capture" xsi:type="string">Credi2\CashpressoPayments\Gateway\Command\BnplCaptureCommand</item>
                <item name="refund" xsi:type="string">Credi2\CashpressoPayments\Gateway\Command\BnplRefundCommand</item>
            </argument>
        </arguments>
    </virtualType>

    <type name="Magento\Sales\Model\Order\Pdf\Invoice">
        <plugin name="credi2_cashpresso_invoice_pdf_rendering_state" type="Credi2\CashpressoPayments\Plugin\Sales\Pdf\InvoiceGetPdfPlugin"/>
    </type>

    <virtualType name="CashpressoBnplInvoiceCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="authorize" xsi:type="string">Credi2\CashpressoPayments\Gateway\Command\BnplAuthorizeCommand</item>
                <item name="capture" xsi:type="string">Credi2\CashpressoPayments\Gateway\Command\BnplCaptureCommand</item>
                <item name="refund" xsi:type="string">Credi2\CashpressoPayments\Gateway\Command\BnplRefundCommand</item>
            </argument>
        </arguments>
    </virtualType>
</config>
