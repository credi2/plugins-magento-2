<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="payment">
            <group id="cashpresso" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>cashpresso Flexible Installments</label>
                <field id="active" translate="label" type="select" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="title" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Title</label>
                    <config_path>payment/cashpresso/title</config_path>
                </field>
                <field id="is_live" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Is Live</label>
                    <source_model>Credi2\CashpressoPayments\Model\Config\Source\LiveMode</source_model>
                    <config_path>payment/cashpresso/is_live</config_path>
                </field>
                <field id="api_key" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>API Key cashpresso</label>
                    <config_path>payment/cashpresso/api_key</config_path>
                </field>
                <field id="api_secret" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>API Secret</label>
                    <config_path>payment/cashpresso/api_secret</config_path>
                </field>
                <field id="validity_hours" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Validity Period</label>
                    <config_path>payment/cashpresso/validity_hours</config_path>
                    <comment>Validity period of orders in hours. Once the validity period is over, the user can no longer pay the purchase with cashpresso.</comment>
                </field>
                <field id="interest_free_days" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Interest Free Days</label>
                    <config_path>payment/cashpresso/interest_free_days</config_path>
                    <comment>If interest free periods are enabled for your merchant account, you can specify the number of interest free days you want to offer to the customer on a per-purchase basis. Please note that this is always on top of whatever cashpresso offers customers.</comment>
                </field>
                <field id="show_on_product_detail_page" translate="label" type="select" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show on Product Detail Page</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>payment/cashpresso/show_on_product_detail_page</config_path>
                </field>
                <field id="show_on_product_listing_page" translate="label" type="select" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show on Category Listing Page</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>payment/cashpresso/show_on_product_listing_page</config_path>
                </field>
                <field id="label_type" translate="label" type="select" sortOrder="75" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Label Type</label>
                    <source_model>Credi2\CashpressoPayments\Model\Config\Source\LabelType</source_model>
                    <config_path>payment/cashpresso/label_type</config_path>
                    <depends>
                        <field id="show_on_product_listing_page">1</field>
                    </depends>
                </field>
                <field id="sort_order" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Sort Order</label>
                    <config_path>payment/cashpresso/sort_order</config_path>
                </field>
            </group>
            <group id="cashpresso_bnpl_invoice" translate="label" type="text" sortOrder="110" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>cashpresso Invoice</label>
                <field id="active" translate="label" type="select" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="title" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Title</label>
                    <config_path>payment/cashpresso_bnpl_invoice/title</config_path>
                </field>
                <field id="is_live" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Is Live</label>
                    <source_model>Credi2\CashpressoPayments\Model\Config\Source\LiveMode</source_model>
                    <config_path>payment/cashpresso_bnpl_invoice/is_live</config_path>
                </field>
                <field id="merchant_id" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Merchant ID cashpresso</label>
                    <config_path>payment/cashpresso_bnpl_invoice/merchant_id</config_path>
                </field>
                <field id="access_token" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Access Token cashpresso</label>
                    <config_path>payment/cashpresso_bnpl_invoice/access_token</config_path>
                </field>
                <field id="payment_action" translate="label" type="select" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Payment Action cashpresso</label>
                    <source_model>Credi2\CashpressoPayments\Model\Config\Source\PaymentAction</source_model>
                    <config_path>payment/cashpresso_bnpl_invoice/payment_action</config_path>
                </field>
                <field id="min_order_total" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Minimum Order Total</label>
                </field>
                <field id="max_order_total" translate="label" type="text" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Maximum Order Total</label>
                </field>
                <field id="sort_order" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Sort Order</label>
                    <config_path>payment/cashpresso_bnpl_invoice/sort_order</config_path>
                </field>
            </group>
            <group id="cashpresso_bnpl_installment" translate="label" type="text" sortOrder="120" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>cashpresso Split Pay</label>
                <field id="active" translate="label" type="select" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="title" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Title</label>
                    <config_path>payment/cashpresso_bnpl_installment/title</config_path>
                </field>
                <field id="is_live" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Is Live</label>
                    <source_model>Credi2\CashpressoPayments\Model\Config\Source\LiveMode</source_model>
                    <config_path>payment/cashpresso_bnpl_installment/is_live</config_path>
                </field>
                <field id="merchant_id" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Merchant ID cashpresso</label>
                    <config_path>payment/cashpresso_bnpl_installment/merchant_id</config_path>
                </field>
                <field id="access_token" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Access Token cashpresso</label>
                    <config_path>payment/cashpresso_bnpl_installment/access_token</config_path>
                </field>
                <field id="payment_action" translate="label" type="select" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Payment Action cashpresso</label>
                    <source_model>Credi2\CashpressoPayments\Model\Config\Source\PaymentAction</source_model>
                    <config_path>payment/cashpresso_bnpl_installment/payment_action</config_path>
                </field>
                <field id="min_order_total" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Minimum Order Total</label>
                </field>
                <field id="max_order_total" translate="label" type="text" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Maximum Order Total</label>
                </field>
                <field id="sort_order" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Sort Order</label>
                    <config_path>payment/cashpresso_bnpl_installment/sort_order</config_path>
                </field>
            </group>


        </section>
    </system>
</config>
