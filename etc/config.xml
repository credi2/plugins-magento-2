<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <payment>
            <cashpresso>
                <active>0</active>
                <title>Ratenzahlung (flexible Laufzeit)</title>
                <is_live>0</is_live>
                <api_key></api_key>
                <api_secret></api_secret>
                <validity_hours>24</validity_hours>
                <interest_free_days>0</interest_free_days>
                <show_on_product_detail_page>1</show_on_product_detail_page>
                <show_on_product_listing_page>1</show_on_product_listing_page>
                <model>CashpressoFacade</model>
                <sort_order>10</sort_order>
                <allowspecific>0</allowspecific>
                <can_use_checkout>1</can_use_checkout>
                <can_use_internal>0</can_use_internal>
                <can_capture>1</can_capture>
                <can_capture_partial>1</can_capture_partial>
                <can_authorize>1</can_authorize>
                <can_refund>1</can_refund>
                <order_status>pending</order_status>
                <payment_action>authorize</payment_action>
            </cashpresso>
            <cashpresso_bnpl_invoice>
                <active>0</active>
                <title>Rechnung (Zahlung innerhalb von 30 Tagen)</title>
                <is_live>0</is_live>
                <model>CashpressoBnplInvoiceFacade</model>
                <sort_order>20</sort_order>
                <allowspecific>0</allowspecific>
                <can_use_checkout>1</can_use_checkout>
                <can_use_internal>0</can_use_internal>
                <can_capture>1</can_capture>
                <can_capture_partial>1</can_capture_partial>
                <can_authorize>1</can_authorize>
                <can_refund>1</can_refund>
                <can_refund_partial_per_invoice>1</can_refund_partial_per_invoice>
                <order_status>pending</order_status>
                <min_order_total>50</min_order_total>
                <max_order_total>200</max_order_total>
                <payment_action>authorize</payment_action>
            </cashpresso_bnpl_invoice>
            <cashpresso_bnpl_installment>
                <active>0</active>
                <title>Teilzahlung (in 3 zinsfreien Raten)</title>
                <is_live>0</is_live>
                <merchant_id></merchant_id>
                <access_token></access_token>
                <model>CashpressoBnplInstallmentFacade</model>
                <sort_order>30</sort_order>
                <allowspecific>0</allowspecific>
                <can_use_checkout>1</can_use_checkout>
                <can_use_internal>0</can_use_internal>
                <can_capture>1</can_capture>
                <can_capture_partial>1</can_capture_partial>
                <can_authorize>1</can_authorize>
                <can_refund>1</can_refund>
                <can_refund_partial_per_invoice>1</can_refund_partial_per_invoice>
                <order_status>pending</order_status>
                <min_order_total>50</min_order_total>
                <max_order_total>200</max_order_total>
                <payment_action>authorize</payment_action>
            </cashpresso_bnpl_installment>
        </payment>
    </default>
</config>
